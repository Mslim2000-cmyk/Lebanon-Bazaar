# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/lebanon_bazaar

# JWT secret — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Server port (default 5000)
PORT=5000

# Environment
NODE_ENV=development
