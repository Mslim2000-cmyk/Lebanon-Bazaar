# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# PostgreSQL connection string
# Local format:  postgresql://USERNAME:PASSWORD@localhost:5432/DBNAME
# Supabase:      postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Render:        copy the "Internal Database URL" from the Render Postgres dashboard
# Railway:       copy from the Railway Postgres service → Connect tab
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/lebanon_bazaar

# JWT secret — generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Server port (default 5000)
PORT=5000

# Environment
NODE_ENV=development

# Vercel Blob token — required in production for file uploads
# Create a Blob store in the Vercel dashboard (Storage → Blob) and copy the token here.
# Not needed for local development (uploads use local filesystem instead).
BLOB_READ_WRITE_TOKEN=
